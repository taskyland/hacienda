{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "extends": ["@taskylizard/biome-config"],
  "linter": {
    "ignore": ["scripts/"],
    "rules": {
      "suspicious": {
        "noReactSpecificProps": "error"
      },
      "style": {
        "noDefaultExport": "off"
      },
      "nursery": {
        "useSortedClasses": "info"
      },
      "correctness": {
        "noUndeclaredVariables": "off"
      }
    }
  }
}
